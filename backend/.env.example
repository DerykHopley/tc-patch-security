# Copy to .env (git-ignored) and run with: uv run --env-file .env uvicorn app.main:app --port 8000
# Every setting the backend reads is listed here; a test checks that.

# The model: fake (scripted, no key, no network), openrouter or local. A bad choice fails at start-up.
LLM_PROVIDER=fake

# OpenRouter. The key is a secret: .env only. Set a spending cap on the key in OpenRouter's settings.
OPENROUTER_API_KEY=
# Default anthropic/claude-haiku-5.5: the best of 11 models in the model check (A20, docs/report/index.html).
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# A local OpenAI-compatible server: Ollama (default), LM Studio (http://localhost:1234/v1), llama.cpp (:8080).
LOCAL_LLM_URL=http://localhost:11434/v1
# The model name as the server lists it, e.g. from `ollama list`. Needed when LLM_PROVIDER=local.
LOCAL_LLM_MODEL=
# The local URL must be on this machine (localhost, 127.0.0.1, ::1). Extra host names allowed (comma-separated).
LOCAL_LLM_HOSTS=

# Watchlist and CVE statuses. Created with the default watchlist if missing. Relative paths are under backend/.
STATE_PATH=data/state.json

# The as-of date ("today" for the data) in snapshot mode. Empty = the snapshot date in fixtures/manifest.json.
AS_OF=

# --- Live data (B02). snapshot = the frozen snapshot (default, tests); live = Check now refreshes the CVE data from
# the feeds, and the as-of date is today (UTC). Live data starts as a copy of the snapshot, in LIVE_PATH.
DATA_MODE=snapshot
LIVE_PATH=data/live
# Where live mode's data comes from. fake = made-up day-1 and day-2 data sets (fixtures/fake_feeds/), no network;
# real = NVD, the CISA KEV catalogue, EPSS (FIRST) and OSV.dev over HTTP. No keys needed.
FEEDS=fake
FAKE_FEEDS_DAY=2
# Optional, with FEEDS=real: an NVD API key (free, https://nvd.nist.gov/developers/request-an-api-key) raises NVD's
# limit from 5 to 50 requests per 30 s. Only matters for a long gap (many pages). A secret: .env only.
NVD_API_KEY=
# A command-line check, the same as the dashboard's Check now: uv run python -m app.refresh
# The schedule: an hourly systemd user timer runs `python -m app.refresh --schedule`, which skips until the Settings
# schedule (every 1, 3, 6, 12 or 24 hours) has passed since the last check. Install: README.md, "Live data from the
# real feeds" (deploy/systemd/install.sh). Switching from FEEDS=fake? Use a fresh LIVE_PATH: the fake CVEs stay in the old one.

# Origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# --- Search. The index is built once with: uv run --env-file .env python -m app.rag.build_index
# The app loads it at start-up and refuses to start if EMBEDDER or EMBED_MODEL changed since: rebuild then.
# hash = free word-matching fake (no key; its index is built automatically when missing),
# openrouter = text-embedding-3-small (needs OPENROUTER_API_KEY above; building costs well under a cent),
# ollama = a local Ollama embedding model (ollama pull <model> first).
EMBEDDER=hash
# Empty = the embedder's default: openai/text-embedding-3-small (openrouter), mxbai-embed-large (ollama, the
# recommended one: best in the A20 retrieval check). EMBEDDER=hash stays the default: free, no service needed.
EMBED_MODEL=
# Where the Chroma index lives. Relative paths are under backend/ (git-ignored).
INDEX_PATH=data/index
# To compare embedders, give each its own index folder, e.g. EMBEDDER=ollama INDEX_PATH=data/index-ollama, build it,
# then run the retrieval check (Dev page, or: uv run --env-file .env python -m app.evals retrieval).
# The model check and the report from the command line: python -m app.evals --help (backend/app/evals/__main__.py).
# Hits below this cosine similarity count as "no match", so off-topic questions get no sources.
# Empty = the default per model, tuned 2026-10-15 (hash 0.15; text-embedding-3-small 0.35; nomic-embed-text and mxbai-embed-large 0.58; qwen3-embedding:0.6b 0.55; other models: their provider's default).
SEARCH_MIN_SCORE=
# Local Ollama server for the ollama embedder; must be on this machine (or a host in LOCAL_LLM_HOSTS).
OLLAMA_URL=http://localhost:11434

# Show the Dev page (internals: model switch, search playground). true or false.
DEV_PANEL=true

# The built frontend (npm run build writes frontend/dist). Set, one port serves the app: the API moves under /api
# and every other path is the frontend. The container sets it; leave it empty locally (Vite serves the frontend).
FRONTEND_DIR=

# --- Alert channels (the Settings page). Secrets go in .env only; the app never shows or stores them.
# Alerts link back to the CVE in the app at this address.
APP_URL=http://localhost:5173

# Phone push via ntfy. The topic works like a password: use a long random name.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
# Only for a protected topic or a self-hosted server with access control.
NTFY_TOKEN=

# Email over SMTP (STARTTLS on 587, TLS on 465). Email counts as set up once SMTP_HOST and ALERT_EMAIL_TO are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Sender (empty = SMTP_USER) and recipient.
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- Web research (research_web, B08): Tavily's hosted MCP server, with its plain search API as the fallback.
# Empty key = web research is off and Patch isn't offered the tool. The key is a secret: .env only. It's sent in
# a header, never in the URL. Free plan: 1,000 credits a month; a basic search costs 1.
TAVILY_API_KEY=
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/
TAVILY_API_URL=https://api.tavily.com
# Searches a day, all users together (30 a day keeps the free credits for the month) and per user.
WEB_RESEARCH_DAILY_CAP=30
WEB_RESEARCH_USER_DAILY_CAP=30
