# Copy to .env (git-ignored) and run with: uv run --env-file .env uvicorn app.main:app --port 8000
# Every setting the backend reads is listed here; a test checks that.
#
# B26: what can change while the app runs is set on Settings by the owner, and is left EMPTY here: DATA_MODE,
# NVD_API_KEY, ALERT_TZ, APP_URL and the alert channels (NTFY_*, SMTP_*, ALERT_EMAIL_*). A value set here still wins,
# and Settings shows it read-only ("set in the server's environment"); delete the line and restart to manage it there.
# The rest stays here only: the app needs it before it can read Settings (the store, the paths, sign-in), or a wrong
# value set from a page could lock you out (AUTH, the Clerk keys, AUTH_ALLOWED_ORIGINS, OWNER, CORS_ORIGINS,
# SCHEDULER_SECRET). Model keys and the test switches stay here too.

# The model: fake (scripted, no key, no network), openrouter or local. A bad choice fails at start-up.
LLM_PROVIDER=fake

# OpenRouter. The key is a secret: .env only. Set a spending cap on the key in OpenRouter's settings.
OPENROUTER_API_KEY=
# Default anthropic/claude-haiku-5.5: the best of 11 models in the model check (A20, docs/report/index.html).
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# A local OpenAI-compatible server: Ollama (default), LM Studio (http://localhost:1234/v1), llama.cpp (:8080).
LOCAL_LLM_URL=http://localhost:11434/v1
# The model name as the server lists it, e.g. from `ollama list`. Needed when LLM_PROVIDER=local.
LOCAL_LLM_MODEL=
# The local URL must be on this machine (localhost, 127.0.0.1, ::1). Extra host names allowed (comma-separated).
LOCAL_LLM_HOSTS=

# Watchlist and CVE statuses. Created with the default watchlist if missing. Relative paths are under backend/.
STATE_PATH=data/state.json
# The owner: the user whose alerts go to the channels below (ntfy, email, desktop). Other users' alerts are shown in
# the app only. Empty = the one local user ("default"), whose state is STATE_PATH. Other users' state files go in
# a folder next to it (data/state-users/). With sign-in (B10), the owner's Clerk user id (user_...): required, the
# app won't start with AUTH=on and no OWNER. The owner's schedule runs the refresh; only the owner can change it.
OWNER=

# --- Sign-in (B10): Clerk; open sign-up, and the owner approves each new account on Settings (B38). off (the
# default, locally and in the tests) = no sign-in, one default user. on = every route but /health needs a signed-in
# user. The frontend reads the publishable key from /health, so it needs no key of its own. The three below aren't
# secrets.
AUTH=off
# From the Clerk dashboard, API keys: the publishable key (pk_test_...).
CLERK_PUBLISHABLE_KEY=
# From the Clerk dashboard, API keys, "JWT public key" (PEM). One line here: write the line breaks as \n.
CLERK_JWT_KEY=
# The origins the app's pages are served from (comma-separated): a session token made on any other page is refused.
# Locally http://localhost:5173; deployed, the service's https://...run.app address.
AUTH_ALLOWED_ORIGINS=
# Optional (B38), a SECRET: the Clerk secret key (sk_test_..., API keys page). Only the owner's Requests card uses it,
# to show names and emails from Clerk; without it the card shows user ids. Never sent to a page.
CLERK_SECRET_KEY=

# The as-of date ("today" for the data) in snapshot mode. Empty = the snapshot date in fixtures/manifest.json.
AS_OF=

# --- Live data (B02). snapshot = the frozen snapshot (default, tests); live = Check now refreshes the CVE data from
# the feeds, and the as-of date is today (UTC). Live data starts as a copy of the snapshot, in LIVE_PATH.
# B26: switched on Settings (Data card) with no restart; leave it empty. Set here, it wins.
DATA_MODE=
LIVE_PATH=data/live
# Where live mode's data comes from. real (the default, B28) = NVD, the CISA KEV catalogue, EPSS (FIRST) and OSV.dev
# over HTTP, no keys needed; fake = made-up day-1 and day-2 data sets (fixtures/fake_feeds/), no network, for tests
# and demos only: its CVEs (CVE-2026-991xx) and their alerts are invented. Settings' Data card says which is on.
# A live folder holds one kind: the app refuses a LIVE_PATH the other kind wrote (move it aside to start fresh).
FEEDS=real
# With FEEDS=fake: which made-up data set (1 or 2).
FAKE_FEEDS_DAY=2
# With FEEDS=fake: feeds that fail, e.g. nvd or nvd,epss, to see a partial refresh (docs/failure-demo.md).
FAKE_FEEDS_FAIL=
# Chat tools that time out inside an answer, e.g. search_security, to see a failed step and Try again
# (docs/failure-demo.md). Leave empty.
FAIL_TOOLS=
# Optional, with FEEDS=real: an NVD API key (free, https://nvd.nist.gov/developers/request-an-api-key) raises NVD's
# limit from 5 to 50 requests per 30 s. Only matters for a long gap (many pages). A secret: here, or (B26) saved on
# Settings' Data card, write-only.
NVD_API_KEY=
# A command-line check, the same as the dashboard's Check now: uv run python -m app.refresh
# The schedule: an hourly systemd user timer runs `python -m app.refresh --schedule`, which skips until the Settings
# schedule (every 1, 3, 6, 12 or 24 hours) has passed since the last check. Install: README.md, "Live data from the
# real feeds" (deploy/systemd/install.sh). In snapshot mode a scheduled run skips (exit 0); a manual run exits 2.

# Origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# --- Search. The index is built once with: uv run --env-file .env python -m app.rag.build_index
# The app loads it at start-up and refuses to start if EMBEDDER or EMBED_MODEL changed since: rebuild then.
# hash = free word-matching fake (no key; its index is built automatically when missing),
# openrouter = text-embedding-3-small (needs OPENROUTER_API_KEY above; building costs well under a cent),
# ollama = a local Ollama embedding model (ollama pull <model> first).
EMBEDDER=hash
# Empty = the embedder's default: openai/text-embedding-3-small (openrouter), mxbai-embed-large (ollama, the
# recommended one: best in the A20 retrieval check). EMBEDDER=hash stays the default: free, no service needed.
EMBED_MODEL=
# Where the Chroma index lives. Relative paths are under backend/ (git-ignored).
INDEX_PATH=data/index
# To compare embedders, give each its own index folder, e.g. EMBEDDER=ollama INDEX_PATH=data/index-ollama, build it,
# then run the retrieval check (Dev page, or: uv run --env-file .env python -m app.evals retrieval).
# The model check and the report from the command line: python -m app.evals --help (backend/app/evals/__main__.py).
# Hits below this cosine similarity count as "no match", so off-topic questions get no sources.
# Empty = the default per model, tuned 2026-10-15 (hash 0.15; text-embedding-3-small 0.35; nomic-embed-text and mxbai-embed-large 0.58; qwen3-embedding:0.6b 0.55; other models: their provider's default).
SEARCH_MIN_SCORE=
# Local Ollama server for the ollama embedder; must be on this machine (or a host in LOCAL_LLM_HOSTS).
OLLAMA_URL=http://localhost:11434

# Show the Dev page (internals: model switch, search playground). true or false.
DEV_PANEL=true

# The built frontend (npm run build writes frontend/dist). Set, one port serves the app: the API moves under /api
# and every other path is the frontend. The container sets it; leave it empty locally (Vite serves the frontend).
FRONTEND_DIR=

# --- Alert channels. B26: all of these are set on Settings by the owner (Delivery card; the time zone on the Alerts
# card), with no restart; leave them empty here. Secrets saved there are write-only: never sent back to the browser.
# A value set here wins, and Settings shows it read-only.
# Alerts link back to the CVE in the app at this address. Empty = http://localhost:5173, which a phone can't open:
# then alerts carry no link (a tap opens the message in the ntfy app). A LAN, Tailscale or Cloud Run address can.
# B61: a public https address here also gives the landing page (/ and /about) its link-preview tags.
APP_URL=

# Phone push via ntfy (empty server = https://ntfy.sh). The topic works like a password: use a long random name.
NTFY_URL=
NTFY_TOPIC=
# Only for a protected topic or a self-hosted server with access control.
NTFY_TOKEN=

# A Telegram message from your own bot (B57). Talk to @BotFather in Telegram: /newbot gives the token. Then send
# your bot any message and use "Find my chat id" on Settings (or getUpdates: README "Alerts"). Telegram counts set up
# once both are set. The token is a secret: it controls your bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email over SMTP (STARTTLS on 587, TLS on 465; empty port = 587, empty STARTTLS = on). Email counts as set up once
# SMTP_HOST and ALERT_EMAIL_TO are set.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=
# Sender (empty = SMTP_USER) and recipient.
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# The time zone of the quiet hours (an IANA name, e.g. Europe/London; empty = UTC until set on Settings, which offers
# the browser's). Alerts found in quiet hours are held and sent as one digest when they end.
ALERT_TZ=
# On: every channel records alerts without sending them (the browser check's live pair uses it).
NOTIFY_DRY_RUN=

# --- Web research (research_web, B08): Tavily's hosted MCP server, with its plain search API as the fallback.
# Empty key = web research is off and Patch isn't offered the tool. The key is a secret: .env only. It's sent in
# a header, never in the URL. Free plan: 1,000 credits a month; a basic search costs 1.
TAVILY_API_KEY=
TAVILY_MCP_URL=https://mcp.tavily.com/mcp/
TAVILY_API_URL=https://api.tavily.com
# Searches a day, all users together (30 a day keeps the free credits for the month) and per user.
WEB_RESEARCH_DAILY_CAP=30
WEB_RESEARCH_USER_DAILY_CAP=30

# Rate limits (B11): chat messages per user, per minute and per day (UTC). Over a limit the chat says when to try
# again. Counted in memory, so correct while the service runs one instance. OpenRouter's spending cap is the backstop.
CHAT_PER_MINUTE=10
CHAT_PER_DAY=200

# --- The deploy (B13): Cloud Run. DEPLOY.md (next to the README) has every step.
# Where users' state and the live data live. local = files (STATE_PATH, LIVE_PATH; the default). gcs = one object per
# user (users/<id>.json) and the live data (live/...) in the Cloud Storage bucket GCS_BUCKET, so they survive restarts
# and scale-to-zero. Credentials: Cloud Run's service account (no key file).
STORE=local
GCS_BUCKET=
# The scheduled refresh: Cloud Scheduler calls POST /api/refresh/scheduled hourly with this in the X-Scheduler-Secret
# header (it runs only when Settings' schedule is due, as the systemd timer's run does). At least 32 characters:
# openssl rand -hex 32. Empty = no such route. A secret: Secret Manager (deployed) or .env only.
SCHEDULER_SECRET=
