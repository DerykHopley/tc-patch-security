# Copy to .env (git-ignored) and run with: uv run --env-file .env uvicorn app.main:app --port 8000
# Every setting the backend reads is listed here; a test checks that.

# The model: fake (scripted, no key, no network), openrouter or local. A bad choice fails at start-up.
LLM_PROVIDER=fake

# OpenRouter. The key is a secret: .env only. Set a spending cap on the key in OpenRouter's settings.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b

# A local OpenAI-compatible server: Ollama (default), LM Studio (http://localhost:1234/v1), llama.cpp (:8080).
LOCAL_LLM_URL=http://localhost:11434/v1
# The model name as the server lists it, e.g. from `ollama list`. Needed when LLM_PROVIDER=local.
LOCAL_LLM_MODEL=
# The local URL must be on this machine (localhost, 127.0.0.1, ::1). Extra host names allowed (comma-separated).
LOCAL_LLM_HOSTS=

# Watchlist and CVE statuses. Created with the default watchlist if missing. Relative paths are under backend/.
STATE_PATH=data/state.json

# The as-of date ("today" for the data). Empty = the snapshot date in fixtures/manifest.json.
AS_OF=

# Origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Show the Dev page (internals: model switch, search playground). true or false.
DEV_PANEL=true

# --- Alert channels (the Settings page). Secrets go in .env only; the app never shows or stores them.
# Alerts link back to the CVE in the app at this address.
APP_URL=http://localhost:5173

# Phone push via ntfy. The topic works like a password: use a long random name.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
# Only for a protected topic or a self-hosted server with access control.
NTFY_TOKEN=

# Email over SMTP (STARTTLS on 587, TLS on 465). Email counts as set up once SMTP_HOST and ALERT_EMAIL_TO are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Sender (empty = SMTP_USER) and recipient.
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
