# Copy to .env. Run with: uv run --env-file .env uvicorn app.main:app --port 8000

# fake (default, no key, no network), openrouter, or local. The dev panel can switch at runtime.
LLM_PROVIDER=fake

# Only needed when LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Local model servers the backend may call, beyond localhost/127.0.0.1/::1 (comma-separated hostnames).
LOCAL_LLM_HOSTS=

# --- Alert channels (secrets stay here, never in the app) ---
# Links in alerts point here.
APP_URL=http://localhost:5173
# Phone push via ntfy. The topic works like a password: make it long and random.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
# Email over SMTP. Port 587 uses STARTTLS, 465 uses TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# Desktop notifications need no settings: notify-send (Linux) or osascript (macOS) on the backend's machine.

# Watchlist and CVE statuses. Created with the default watchlist if missing.
STATE_PATH=data/state.json

# "Today" for the dashboard. Empty = the snapshot date in fixtures/manifest.json.
AS_OF=

# Origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174

# Agent loop limit (T7). The dev panel's saved value overrides it.
MAX_STEPS=4

# The dev panel exposes internals (index facts, the search playground). Turn it off outside your machine.
DEV_PANEL=true
